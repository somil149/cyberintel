    "fuse.js": "7.0.0",
    "leaflet": "1.9.4",
    "next": "^16.2.4",
    "react": "18.3.1",
    "react-chartjs-2": "5.2.0",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/leaflet": "1.9.12",
    "@types/node": "20.12.12",
    "@types/react": "18.3.3",
    "autoprefixer": "10.4.19",
    "gh-pages": "6.1.1",
